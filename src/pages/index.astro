---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LogoWall from '../components/LogoWall.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import AreaCards from '../components/AreaCards.astro';
import DeliveryModel from '../components/DeliveryModel.astro';
import IndustryTabs from '../components/IndustryTabs.astro';
import { clients, partners } from '../data/logos';
import { offices, site } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const cyber = services.filter((s) => s.data.area === 'cybersecurity-digital-risk');
const phases = [
  { key: 'assess', title: 'Assess first', text: 'We test your organisation the way an attacker would, so you know exactly where you are exposed.' },
  { key: 'protect', title: 'Protect proactively', text: 'We put the right controls, monitoring and training in place to close the gaps and keep them closed.' },
  { key: 'respond', title: 'Respond effectively', text: 'When something happens, our team contains it, finds the cause and gets you running again. Day or night.' },
] as const;
---
<Base title={`CSL Cyber Sentinel Lab | ${site.descriptor}`} description="CSL (Cyber Sentinel Lab) is a Dubai cybersecurity and business technology solutions partner: cybersecurity, fraud and compliance, payments and reconciliation, smart infrastructure, cloud and IT services across the UAE, GCC and Europe.">
  <Hero />

  <section class="clients" aria-labelledby="clients-h">
    <div class="wrap">
      <h2 id="clients-h" class="c-h">Trusted by more than 30 organisations, including</h2>
      <LogoWall logos={clients} variant="marquee" />
    </div>
  </section>

  <section class="section" aria-labelledby="sol-h">
    <div class="wrap">
      <div class="shead split">
        <h2 id="sol-h" class="h2">Solutions that protect and simplify</h2>
        <p class="lead">Cybersecurity is our core. Around it, we bring together specialist solutions for fraud and compliance, payments, smart infrastructure, cloud and everyday IT.</p>
      </div>
      <AreaCards />
    </div>
  </section>

  <section class="section band-white" aria-labelledby="core-h">
    <div class="wrap">
      <div class="shead split">
        <h2 id="core-h" class="h2">Cybersecurity is where we started</h2>
        <p class="lead">Our specialists bring more than 25 years of combined experience protecting airports, seaports, universities, hospitals and government departments. Our approach follows the three sides of our logo.</p>
      </div>
      <ol role="list" class="phases">
        {phases.map((p) => (
          <li class="phase">
            <div class="p-top"><i class={`ph ph-${p.key}`} aria-hidden="true"></i><h3 class="h3">{p.title}</h3></div>
            <p class="p-t">{p.text}</p>
            <ul role="list" class="svc">
              {cyber.filter((s) => s.data.phase === p.key).map((s) => <li><a href={`/services/${s.id}`}>{s.data.title}</a></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="dm-h">
    <div class="wrap">
      <div class="shead split">
        <h2 id="dm-h" class="h2">One partner, the right expertise</h2>
        <p class="lead">Some solutions we deliver with our own team. Others we deliver with specialist partners. Either way, you deal with CSL, and we always tell you who does what.</p>
      </div>
      <DeliveryModel />
    </div>
  </section>

  <section class="section tight" aria-labelledby="ind-h">
    <div class="wrap">
      <div class="shead split">
        <h2 id="ind-h" class="h2">Built for your sector</h2>
        <p class="lead">Practical solutions for the sectors we know best. <a class="lnk" href="/industries">See all industries</a></p>
      </div>
      <IndustryTabs />
    </div>
  </section>

  <section class="section" aria-labelledby="part-h">
    <div class="wrap">
      <div class="shead split">
        <h2 id="part-h" class="h2">Technology partners</h2>
        <p class="lead">We work with leading security, cloud and technology vendors, and recommend what fits your environment.</p>
      </div>
      <LogoWall logos={partners.slice(0, 14)} />
      <p class="after"><a class="lnk" href="/partners">How we work with partners</a></p>
    </div>
  </section>

  <section class="section tight" aria-labelledby="reach-h">
    <div class="wrap reach">
      <h2 id="reach-h" class="h2">Close to you, in three regions</h2>
      <ul role="list" class="offices">
        {offices.map((o) => (
          <li>
            <h3>{o.region}</h3>
            <p class="muted">{o.label === 'Headquarters' ? 'Headquarters, Dubai' : o.address[o.address.length - 1]}</p>
            <a href={`mailto:${o.email}`}>{o.email}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section tight" aria-labelledby="ins-h">
      <div class="wrap">
        <div class="shead split">
          <h2 id="ins-h" class="h2">Insights</h2>
          <p class="lead">Practical guidance from our specialists. <a class="lnk" href="/insights">All insights</a></p>
        </div>
        <div class="grid g3 posts">{posts.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}

  <CtaBand title="Tell us what you need." text="Share your requirement and we will come back with a clear recommendation: what to do, who should deliver it, and where to start." button="Discuss your requirement" />
</Base>

<style>
  .clients { background: var(--surface); border-block: 1px solid var(--line); padding: 34px 0 30px; }
  .c-h { font-size: 0.98rem; font-weight: 500; color: var(--muted); margin-bottom: 20px; }

  .phases { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--ink); }
  .phase { padding: 30px 30px 10px 0; display: flex; flex-direction: column; gap: 16px; }
  .phase + .phase { padding-left: 30px; border-left: 1px solid var(--line); }
  .p-top { display: flex; gap: 12px; align-items: center; }
  .p-top .ph { width: 22px; height: 22px; }
  .p-t { color: var(--ink-2); }
  .svc { display: grid; padding-top: 6px; }
  .svc a { display: block; padding: 12px 0; border-top: 1px solid var(--line); font-weight: 600; }
  .svc a:hover { color: var(--green-ink); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) {
    .phases { grid-template-columns: 1fr; }
    .phase, .phase + .phase { padding: 26px 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }

  .after { margin-top: 22px; font-weight: 600; }

  .reach { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: start; }
  .offices { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--ink); }
  .offices li { padding: 22px 20px 0 0; display: grid; gap: 6px; }
  .offices h3 { font-stretch: 115%; font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; }
  .offices a { color: var(--green-ink); font-weight: 500; font-size: 0.95rem; word-break: break-word; }
  @media (max-width: 900px) { .reach { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .offices { grid-template-columns: 1fr; } .offices li { padding-bottom: 18px; border-bottom: 1px solid var(--line); } }

  .posts { gap: 36px; }
</style>
