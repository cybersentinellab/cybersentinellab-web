---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import DeliveryModel from '../../components/DeliveryModel.astro';
import Icon from '../../components/Icon.astro';
import { areas } from '../../data/areas';
import { site } from '../../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const listSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'CSL solutions',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.title, url: `${site.url}/services/${s.id}` })),
};
const crumbs = [{ name: 'Solutions', href: '/solutions' }];
---
<Base title="Solutions: Cybersecurity, Fraud & Compliance, Payments, Smart Infrastructure, Cloud & IT" description="CSL solutions across six areas: cybersecurity and digital risk, fraud risk and compliance, payments and reconciliation, smart infrastructure and automation, cloud solutions, and IT services and software development." crumbs={crumbs} schema={[listSchema]}>
  <PageHero title="Solutions" lead="Six solution areas, one partner. Cybersecurity is our core specialism; around it we bring together the solutions that help you protect your business and simplify your operations." crumbs={crumbs} />
  {areas.map((a, i) => (
    <section class="grp" aria-labelledby={`a-${a.slug}`}>
      <div class="wrap row">
        <div class="side">
          <span class="ic"><Icon name={a.icon} size={28} /></span>
          {i === 0 && <span class="core">Our core specialism</span>}
          <h2 id={`a-${a.slug}`} class="h2"><a href={`/solutions/${a.slug}`}>{a.title}</a></h2>
          <p>{a.short}</p>
          <a class="lnk" href={`/solutions/${a.slug}`}>Explore {a.title}</a>
        </div>
        <ul role="list" class="list">
          {services.filter((s) => s.data.area === a.slug).map((s) => (
            <li><a href={`/services/${s.id}`}><h3>{s.data.title}</h3><p>{s.data.summary}</p></a></li>
          ))}
        </ul>
      </div>
    </section>
  ))}
  <section class="section">
    <div class="wrap">
      <div class="shead split">
        <h2 class="h2">How we deliver</h2>
        <p class="lead">Directly where we specialise, with partners where they are better placed, always coordinated by CSL.</p>
      </div>
      <DeliveryModel />
    </div>
  </section>
  <CtaBand title="Not sure where to start?" text="Tell us about your organisation. We will recommend the few solutions that matter most for your risks, sector and goals." button="Discuss your requirement" />
</Base>
<style>
  .grp { padding-block: clamp(56px, 7vw, 96px); border-bottom: 1px solid var(--line); }
  .grp:nth-of-type(even) { background: var(--surface); }
  .row { display: grid; grid-template-columns: 1fr 1.8fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .side { position: sticky; top: 110px; display: grid; gap: 14px; justify-items: start; }
  .side .ic { color: var(--green); }
  .core { font-size: 0.85rem; font-weight: 600; padding: 3px 10px; border-radius: var(--r-sm); background: var(--ink); color: #fff; }
  .side .h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .side .h2 a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .side p { color: var(--ink-2); }
  .lnk { font-weight: 600; }
  .list { border-top: 2px solid var(--ink); }
  .list a { display: block; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .list h3 { font-stretch: 115%; font-size: clamp(1.2rem, 1.9vw, 1.5rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
  .list p { color: var(--ink-2); margin-top: 6px; max-width: 60ch; }
  .list a:hover h3 { color: var(--green-ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 860px) { .row { grid-template-columns: 1fr; } .side { position: static; } }
</style>
