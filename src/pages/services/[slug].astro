---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import ServiceRows from '../../components/ServiceRows.astro';
import { serviceSchema, faqSchema } from '../../data/schema';
import { industries } from '../../data/industries';

export async function getStaticPaths() {
  const all = await getCollection('services');
  return all.map((s) => ({ params: { slug: s.id }, props: { s, all } }));
}
const { s, all } = Astro.props;
const d = s.data;
const { Content } = await render(s);
const related = all.filter((x) => x.id !== s.id && x.data.phase === d.phase).slice(0, 3).map((x) => x.id);
const relatedIds = related.length >= 2 ? related : all.filter((x) => x.id !== s.id).sort((a, b) => Math.abs(a.data.order - d.order) - Math.abs(b.data.order - d.order)).slice(0, 3).map((x) => x.id);
const inds = industries.filter((i) => i.services.includes(s.id));
const crumbs = [{ name: 'Services', href: '/services' }, { name: d.title, href: `/services/${s.id}` }];
---
<Base title={d.seoTitle ?? d.title} description={d.metaDescription ?? d.summary} crumbs={crumbs} schema={[serviceSchema({ title: d.title, summary: d.summary, slug: s.id }), faqSchema(d.faqs)]}>
  <PageHero title={d.title} lead={d.intro} crumbs={crumbs} phase={d.phase}>
    <div class="ctas">
      <a class="btn btn-primary" href={`/contact?service=${s.id}`}>Book a consultation</a>
      <a class="btn btn-ghost" href="#faq-h">Read the FAQ</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap cover">
      <h2 class="h2">What's included</h2>
      <ul role="list" class="feat">
        {d.features.map((f) => (
          <li><h3>{f.title}</h3><p>{f.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  {d.steps.length > 0 && (
    <section class="section tight">
      <div class="wrap">
        <h2 class="h2 sh">How we work</h2>
        <ol class="flow" role="list">
          {d.steps.map((st, i) => (
            <li><span class="n">Step {i + 1}</span><h3>{st.title}</h3><p>{st.text}</p></li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {d.outcomes.length > 0 && (
    <section class="section band-white">
      <div class="wrap out">
        <h2 class="h2">What you get</h2>
        <ul role="list">{d.outcomes.map((o) => <li><Icon name="check" size={22} />{o}</li>)}</ul>
      </div>
    </section>
  )}

  <div class="wrap prose-wrap"><div class="prose"><Content /></div></div>

  <div class="faq-wrap"><Faq faqs={d.faqs} /></div>

  {inds.length > 0 && (
    <section class="section tight">
      <div class="wrap">
        <h2 class="h3 sh">Sectors where this matters most</h2>
        <ul role="list" class="chips">{inds.map((i) => <li><a href={`/industries/${i.slug}`}><Icon name={i.icon} size={18} />{i.title}</a></li>)}</ul>
      </div>
    </section>
  )}

  <section class="section tight">
    <div class="wrap">
      <h2 class="h2 sh">Related services</h2>
      <ServiceRows only={relatedIds} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .ctas { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .cover { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .feat { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid var(--ink); }
  .feat li { padding: 24px 24px 26px 0; border-bottom: 1px solid var(--line); }
  .feat li:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--line); }
  .feat h3 { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 6px; }
  .feat p { color: var(--ink-2); font-size: 0.98rem; }
  @media (max-width: 900px) { .cover { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .feat { grid-template-columns: 1fr; } .feat li:nth-child(even) { padding-left: 0; border-left: 0; } }
  .sh { margin-bottom: clamp(28px, 4vw, 48px); }
  .flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; counter-reset: f; }
  .flow li { position: relative; padding: 26px 22px 0 0; border-top: 2px solid var(--ink); }
  .flow li::before { content: ''; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; background: var(--green); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .n { font-size: 0.85rem; color: var(--muted); }
  .flow h3 { font-stretch: 115%; font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; margin: 6px 0 8px; }
  .flow p { color: var(--ink-2); font-size: 0.98rem; }
  .out { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .out ul { display: grid; gap: 18px; }
  .out li { display: flex; gap: 14px; align-items: flex-start; font-stretch: 110%; font-size: clamp(1.15rem, 1.8vw, 1.45rem); font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; }
  .out li :global(svg) { color: var(--green); flex: none; margin-top: 3px; }
  @media (max-width: 900px) { .out { grid-template-columns: 1fr; } }
  .prose-wrap:has(.prose:empty) { display: none; }
  .prose-wrap { padding-block: var(--section) 0; }
  .faq-wrap { padding-top: var(--section); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chips a { display: inline-flex; align-items: center; gap: 10px; padding: 11px 18px; border: 1.5px solid var(--ink); border-radius: var(--r-sm); font-weight: 600; }
  .chips a:hover { background: var(--ink); color: #fff; }
  .chips :global(svg) { color: var(--green); }
  .chips a:hover :global(svg) { color: #fff; }
</style>
