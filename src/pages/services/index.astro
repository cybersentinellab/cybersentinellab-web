---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { key: 'assess', title: 'Assess first', text: 'Find out where you are exposed, and what to fix first.' },
  { key: 'protect', title: 'Protect proactively', text: 'Put controls, tools and skills in place that keep attackers out.' },
  { key: 'respond', title: 'Respond effectively', text: 'Contain incidents fast, find the cause and recover.' },
  { key: 'technology', title: 'Technology', text: 'Infrastructure, software, licensing and fintech, built with security in mind.' },
] as const;
const listSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Cyber Sentinel Lab services',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.title, url: `${site.url}/services/${s.id}` })),
};
const crumbs = [{ name: 'Services', href: '/services' }];
---
<Base title="Cybersecurity & Technology Services in Dubai & UAE" description="Cyber Sentinel Lab services: penetration testing, security assessment, compliance (UAE IA, ISO 27001), threat intelligence, EDR/NDR, Zero Trust, OT and IoMT security, cloud, incident response, infrastructure, software, licensing and fintech." crumbs={crumbs} schema={[listSchema]}>
  <PageHero title="Services" lead="Everything we do follows one approach: assess first, protect proactively, respond effectively. Alongside it, we build and run the technology your business depends on." crumbs={crumbs} />
  {groups.map((g) => (
    <section class="grp" aria-labelledby={`g-${g.key}`}>
      <div class="wrap row">
        <div class="side">
          <i class={`ph ph-${g.key}`} aria-hidden="true"></i>
          <h2 id={`g-${g.key}`} class="h2">{g.title}</h2>
          <p class="muted">{g.text}</p>
        </div>
        <ul role="list" class="list">
          {services.filter((s) => s.data.phase === g.key).map((s) => (
            <li><a href={`/services/${s.id}`}><h3>{s.data.title}</h3><p>{s.data.summary}</p></a></li>
          ))}
        </ul>
      </div>
    </section>
  ))}
  <CtaBand title="Not sure where to start?" text="Tell us about your organisation. We will recommend the few services that matter most for your risks, sector and regulations." />
</Base>
<style>
  .grp { padding-block: clamp(56px, 7vw, 96px); border-bottom: 1px solid var(--line); }
  .grp:nth-of-type(even) { background: var(--surface); }
  .row { display: grid; grid-template-columns: 1fr 1.8fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .side { position: sticky; top: 110px; display: grid; gap: 14px; justify-items: start; }
  .side .ph { width: 28px; height: 28px; }
  .side .h2 { font-size: clamp(1.9rem, 3.2vw, 2.8rem); }
  .list { border-top: 2px solid var(--ink); }
  .list a { display: block; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .list h3 { font-stretch: 115%; font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
  .list p { color: var(--ink-2); margin-top: 8px; max-width: 60ch; }
  .list a:hover h3 { color: var(--green-ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 860px) { .row { grid-template-columns: 1fr; } .side { position: static; } }
</style>
