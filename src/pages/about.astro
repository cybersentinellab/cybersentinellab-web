---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import LogoWall from '../components/LogoWall.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { clients, partners } from '../data/logos';
import { offices } from '../data/site';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'About', href: '/about' }];
const pillars = [
  { k: 'Mission', icon: 'target', p: 'To provide end-to-end cybersecurity and risk management services that strengthen business resilience and ensure compliance with global standards. By combining expert knowledge, advanced technologies and client-focused strategies, we create long-term value and help organisations thrive securely in the digital era.' },
  { k: 'Vision', icon: 'eye', p: 'To become a trusted global leader in cybersecurity by delivering innovative, reliable and future-ready solutions — empowering organisations to embrace digital transformation with confidence, knowing their assets, data and operations are safeguarded.' },
  { k: 'Strategy', icon: 'users', p: 'Our team brings together highly skilled cybersecurity experts with years of industry experience. Their combined expertise ensures innovative, reliable and future-ready solutions for every client.' },
  { k: 'Innovation', icon: 'radar', p: 'We assess your digital operations, risk landscape and compliance needs in depth, working side by side with you to identify strengths, weaknesses, opportunities and threats — so your business stays secure.' },
];
const approach = [
  ['Assess', 'First', 'We begin by understanding your business, systems and potential risks. Through in-depth assessments and penetration testing, we identify vulnerabilities before attackers can exploit them.'],
  ['Protect', 'Proactively', 'Using advanced tools and proven strategies, we design tailored security measures. Our proactive approach strengthens your defences and ensures compliance with industry standards.'],
  ['Respond', 'Effectively', 'If threats arise, our experts act fast to contain, resolve and recover. With clear remediation steps, we help you minimise damage and maintain business continuity.'],
];
---
<Base title="About Us" description="Cyber Sentinel Lab is a Dubai-headquartered cybersecurity firm with 25+ years of combined expertise, offices in the UAE, Denmark and India, and strategic technology partnerships across Europe, the GCC and the UAE." crumbs={crumbs}>
  <PageHero title="Your shield in the <em>digital world</em>" lead="At Cyber Sentinel Lab, we protect businesses and governments from evolving cyber threats with advanced penetration testing, threat intelligence and incident response — keeping digital assets secure, resilient and future-ready." crumbs={crumbs}>
    <div class="nums">
      <div><b>25<sup>+</sup></b><span>Years of combined expertise</span></div>
      <div><b>30<sup>+</sup></b><span>Client references — and growing…</span></div>
    </div>
  </PageHero>

  <section class="section tight">
    <div class="wrap grid g2">
      {pillars.map((p) => (
        <div class="card top pil" data-reveal>
          <Icon name={p.icon} size={28} />
          <h2 class="h3">Our <span class="s">{p.k}</span></h2>
          <p class="muted">{p.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <SectionHead eyebrow="Our approach" title="Assess. Protect. <em>Respond.</em>" />
      <ol class="appr">
        {approach.map(([t, a, p], i) => (
          <li data-reveal><span class="n s">0{i + 1}</span><h3 class="h3">{t} <span class="s">{a}</span></h3><p class="muted">{p}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tight" id="partners">
    <div class="wrap">
      <SectionHead split eyebrow="Strategic partnerships" title="Strong partnerships, <em>stronger</em> security." text="By collaborating with leading technology providers and trusted organisations, we deliver innovative solutions that keep businesses ahead of cyber threats. Our partnerships extend across Europe, the GCC and the UAE — global expertise with a local presence." />
      <LogoWall logos={partners} />
    </div>
  </section>

  <section class="section tight" id="clients">
    <div class="wrap">
      <SectionHead split eyebrow="Client references" title="30+ clients <em>and growing.</em>" text="We work closely with organisations driven by bold objectives, helping them build, implement and continuously enhance their cyber defence capabilities." />
      <LogoWall logos={clients} />
    </div>
  </section>

  {team.length > 0 && (
    <section class="section tight">
      <div class="wrap">
        <SectionHead eyebrow="Leadership" title="The people behind <em>the shield.</em>" />
        <ul role="list" class="grid g4 team">
          {team.map((m) => (
            <li class="card" data-reveal>
              {m.data.photo && <img src={m.data.photo.src} alt={m.data.title} loading="lazy" width="320" height="320" />}
              <h3>{m.data.title}</h3><p class="muted">{m.data.role}</p>
              {m.data.linkedin && <a href={m.data.linkedin} target="_blank" rel="noopener" aria-label={`${m.data.title} on LinkedIn`}><Icon name="linkedin" size={18} /></a>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section tight">
    <div class="wrap">
      <SectionHead eyebrow="Our offices" title="UAE · Europe · <em>India</em>" />
      <div class="grid g3">
        {offices.map((o) => (
          <div class="card off" data-reveal>
            <p class="eyebrow">{o.label}</p>
            <h3 class="h3">{o.region}</h3>
            <p class="muted">{o.company && <>{o.company}<br /></>}{o.address.map((l) => <>{l}<br /></>)}</p>
            <a href={`mailto:${o.email}`}>{o.email}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .nums { display: flex; gap: 48px; margin-top: 40px; flex-wrap: wrap; }
  .nums b { display: block; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: 4.5rem; line-height: 1; }
  .nums sup { color: var(--accent); font-size: 0.5em; vertical-align: top; }
  .nums span { color: var(--muted); font-size: 0.9rem; }
  .pil { display: flex; flex-direction: column; gap: 16px; }
  .pil :global(svg) { color: var(--accent); }
  .appr { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 40px; border-top: 1px solid var(--line); padding-top: 40px; }
  .appr .n { font-size: 3.5rem; color: #2a3146; display: block; line-height: 1; margin-bottom: 18px; }
  .appr h3 { margin-bottom: 12px; }
  .team { list-style: none; }
  .team img { border-radius: 14px; aspect-ratio: 1; object-fit: cover; margin-bottom: 18px; }
  .team h3 { font-size: 1.15rem; }
  .off { display: flex; flex-direction: column; gap: 12px; }
  .off a { color: var(--accent); }
</style>
