---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPosts, kindMeta, slugify, type Kind } from '../../lib/posts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const kinds = [...new Set(posts.map((p) => p.collection as Kind))];
const crumbs = [{ name: 'Insights', href: '/insights' }];
---
<Base title="Insights: Cybersecurity Blog, News & Case Studies" description="Cybersecurity insights from Cyber Sentinel Lab: practical guidance, analysis, news and case studies for organisations in the UAE, GCC and Europe." crumbs={crumbs}>
  <PageHero title="Insights from <em>the Lab</em>" lead="Practical guidance, analysis and news from our security specialists." crumbs={crumbs} />
  <section class="section tight">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="lead">New articles are on their way. In the meantime, <a href="/contact" class="lnk">talk to our team</a>.</p>
      ) : (
        <>
          <div class="tools">
            <label class="search"><span class="sr-only">Search insights</span><input type="search" id="q" placeholder="Search insights…" autocomplete="off" /></label>
            <div class="filters" role="group" aria-label="Filter by type">
              <button class="chip on" data-kind="">All</button>
              {kinds.map((k) => <button class="chip" data-kind={k}>{kindMeta[k].label}</button>)}
            </div>
          </div>
          {tags.length > 0 && <p class="tags">Topics: {tags.map((t) => <a href={`/insights/tags/${slugify(t)}`} class="tag">{t}</a>)}</p>}
          <div class="grid g3" id="list">
            {posts.map((p) => (
              <div data-kind={p.collection} data-text={`${p.data.title} ${p.data.excerpt} ${p.data.tags.join(' ')}`.toLowerCase()}>
                <PostCard post={p} />
              </div>
            ))}
          </div>
          <p class="empty" id="empty" hidden>No insights match your search.</p>
        </>
      )}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .tools { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .search input { width: min(420px, 100%); background: var(--bg-2); border: 1px solid var(--line-2); border-radius: 999px; padding: 13px 22px; color: var(--text); font-size: 1rem; }
  .search { flex: 1; max-width: 420px; }
  .search input:focus { outline: none; border-color: var(--accent); }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip { background: none; border: 1px solid var(--line-2); border-radius: 999px; padding: 9px 18px; cursor: pointer; font-size: 0.9rem; color: var(--muted); }
  .chip.on, .chip:hover { border-color: var(--accent); color: var(--accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--muted); font-size: 0.9rem; margin-bottom: 36px; }
  .tags a:hover { border-color: var(--accent); color: var(--accent); }
  .empty { color: var(--muted); margin-top: 30px; }
  .lnk { color: var(--accent); }
</style>
<script>
  const q = document.getElementById('q') as HTMLInputElement | null;
  if (q) {
    const items = [...document.querySelectorAll<HTMLElement>('#list > div')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
    let kind = '';
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let n = 0;
      items.forEach((el) => { const show = (!kind || el.dataset.kind === kind) && (!term || el.dataset.text!.includes(term)); el.hidden = !show; if (show) n++; });
      document.getElementById('empty')!.hidden = n > 0;
    };
    q.addEventListener('input', apply);
    chips.forEach((c) => c.addEventListener('click', () => { kind = c.dataset.kind!; chips.forEach((x) => x.classList.toggle('on', x === c)); apply(); }));
  }
</script>
