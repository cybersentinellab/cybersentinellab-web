---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { offices, site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const crumbs = [{ name: 'Contact', href: '/contact' }];
const contactSchema = {
  '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Cyber Sentinel Lab', url: `${site.url}/contact`,
  mainEntity: { '@id': `${site.url}/#org` },
};
---
<Base title="Contact Us" description="Contact Cyber Sentinel Lab in Dubai for penetration testing, incident response and cybersecurity consulting. Call +971 55 881 7003, WhatsApp us or send a message." crumbs={crumbs} schema={[contactSchema]}>
  {siteKey && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <PageHero title="Talk to our team" lead="Tell us what you need protected. A specialist will get back to you shortly. For an active incident, call or WhatsApp us now." crumbs={crumbs} />

  <section class="section tight" style="padding-top:0">
    <div class="wrap layout">
      <form id="cf" class="card form" action="/api/contact" method="post" novalidate>
        <div class="row">
          <label>Full name<input name="name" required autocomplete="name" /></label>
          <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="row">
          <label>Company<input name="company" autocomplete="organization" /></label>
          <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
        </div>
        <label>Service of interest
          <select name="service">
            <option value="">Select a service (optional)</option>
            {services.map((s) => <option value={s.id}>{s.data.title}</option>)}
            <option value="other">Something else</option>
          </select>
        </label>
        <label>How can we help?<textarea name="message" rows="6" required></textarea></label>
        <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="chk"><input type="checkbox" name="consent" required /> <span>I agree that Cyber Sentinel Lab may contact me about this enquiry, as described in the <a href="/privacy-policy">privacy policy</a>.</span></label>
        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>}
        <button class="btn btn-primary" type="submit">Send message</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="side">
        <div class="card urgent">
          <p class="eyebrow">Urgent incident?</p>
          <p class="big">Call or WhatsApp our team now.</p>
          <a class="btn btn-accent" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp us</a>
          <a class="line" href="tel:+971558817003"><Icon name="phone" size={18} />+971 55 881 7003</a>
          <a class="line" href="tel:+971554798978"><Icon name="phone" size={18} />+971 55 479 8978</a>
          <a class="line" href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
        </div>
        {offices.map((o) => (
          <div class="off">
            <p class="eyebrow">{o.label}</p>
            <h2>{o.region}</h2>
            <p class="muted"><Icon name="pin" size={16} />{o.company && <>{o.company}, </>}{o.address.join(', ')}</p>
            <p><a href={`mailto:${o.email}`}>{o.email}</a> · <a href={`https://${o.web}`} target="_blank" rel="noopener">{o.web}</a> · <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.address.join(', '))}`} target="_blank" rel="noopener">Map</a></p>
          </div>
        ))}
      </aside>
    </div>
  </section>

</Base>

<style>
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: start; padding-top: clamp(48px, 6vw, 80px); }
  .form { display: grid; gap: 20px; border-radius: var(--r-lg); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label { display: grid; gap: 8px; font-size: 0.95rem; font-weight: 600; color: var(--ink); }
  input, select, textarea { background: var(--paper); border: 1.5px solid var(--line-2); border-radius: var(--r-sm); padding: 13px 14px; color: var(--ink); font-size: 1rem; font-weight: 400; width: 100%; transition: border-color 0.15s, background 0.15s; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); background-position: calc(100% - 22px) 52%, calc(100% - 16px) 52%; background-size: 6px 6px; background-repeat: no-repeat; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--green); background: #fff; box-shadow: 0 0 0 3px var(--green-wash); }
  input:user-invalid, textarea:user-invalid { border-color: var(--respond); }
  .chk { display: flex; gap: 12px; align-items: flex-start; line-height: 1.5; font-weight: 400; color: var(--ink-2); }
  .chk input { width: 18px; height: 18px; flex: none; margin-top: 3px; accent-color: var(--green-ink); }
  .hp { position: absolute; left: -9999px; }
  .form .btn { justify-self: start; }
  .status { min-height: 1.4em; font-size: 0.98rem; font-weight: 500; }
  .status.ok { color: var(--green-ink); } .status.err { color: #b3121c; }
  .side { display: grid; gap: 28px; }
  .urgent { display: grid; gap: 14px; background: var(--ink); color: #fff; border: 0; }
  .urgent .eyebrow { color: rgba(255,255,255,.7); font-size: 0.95rem; }
  .big { font-stretch: 115%; font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em; line-height: 1.2; }
  .urgent .btn { justify-self: start; background: #fff; color: var(--ink); }
  .urgent .btn:hover { background: var(--assess); }
  .line { display: flex; gap: 10px; align-items: center; color: #fff; }
  .line:hover { text-decoration: underline; text-underline-offset: 3px; }
  .line :global(svg) { color: var(--assess); flex: none; }
  .off { border-top: 2px solid var(--ink); padding-top: 18px; display: grid; gap: 6px; }
  .off .eyebrow { color: var(--muted); font-size: 0.9rem; }
  .off h2 { font-stretch: 115%; font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; }
  .off .muted { display: flex; gap: 8px; font-size: 0.95rem; }
  .off :global(svg) { color: var(--green); flex: none; margin-top: 3px; }
  .off a { color: var(--green-ink); font-size: 0.95rem; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .layout, .row { grid-template-columns: 1fr; } }
</style>

<script>
  const f = document.getElementById('cf') as HTMLFormElement;
  const st = f.querySelector('.status') as HTMLElement;
  const svc = new URLSearchParams(location.search).get('service');
  if (svc) (f.elements.namedItem('service') as HTMLSelectElement).value = svc;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    st.className = 'status';
    if (!f.checkValidity()) { f.reportValidity(); return; }
    const btn = f.querySelector('button') as HTMLButtonElement;
    btn.disabled = true; st.textContent = 'Sending…';
    try {
      const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.error || 'Something went wrong.');
      f.reset(); st.classList.add('ok'); st.textContent = 'Message sent. Our team will reply to you by email shortly.';
    } catch (err) {
      st.classList.add('err'); st.textContent = `${(err as Error).message} You can also email reachus@cybersentinellab.com or message us on WhatsApp.`;
    } finally {
      btn.disabled = false;
      (window as any).turnstile?.reset();
    }
  });
</script>
