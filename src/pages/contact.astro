---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { offices, site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const crumbs = [{ name: 'Contact', href: '/contact' }];
const contactSchema = {
  '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Cyber Sentinel Lab', url: `${site.url}/contact`,
  mainEntity: { '@id': `${site.url}/#org` },
};
---
<Base title="Contact Us" description="Contact Cyber Sentinel Lab in Dubai for penetration testing, incident response and cybersecurity consulting. Call +971 55 881 7003, WhatsApp us or send a message." crumbs={crumbs} schema={[contactSchema]}>
  {siteKey && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <PageHero title="Let's talk <em>security.</em>" lead="Tell us what you need protected. A specialist will get back to you shortly. For an active incident, call or WhatsApp us now." crumbs={crumbs} />

  <section class="section tight">
    <div class="wrap layout">
      <form id="cf" class="card form" action="/api/contact" method="post" novalidate>
        <div class="row">
          <label>Full name<input name="name" required autocomplete="name" /></label>
          <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="row">
          <label>Company<input name="company" autocomplete="organization" /></label>
          <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
        </div>
        <label>Service of interest
          <select name="service">
            <option value="">Select a service (optional)</option>
            {services.map((s) => <option value={s.id}>{s.data.title}</option>)}
            <option value="other">Something else</option>
          </select>
        </label>
        <label>How can we help?<textarea name="message" rows="6" required></textarea></label>
        <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="chk"><input type="checkbox" name="consent" required /> <span>I agree that Cyber Sentinel Lab may contact me about this enquiry, as described in the <a href="/privacy-policy">privacy policy</a>.</span></label>
        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark"></div>}
        <button class="btn btn-accent" type="submit">Send message <span class="arr">→</span></button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="side">
        <div class="card urgent">
          <p class="eyebrow">Urgent incident?</p>
          <p class="big">Call or WhatsApp our team now.</p>
          <a class="btn btn-accent" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp us</a>
          <a class="line" href="tel:+971558817003"><Icon name="phone" size={18} />+971 55 881 7003</a>
          <a class="line" href="tel:+971554798978"><Icon name="phone" size={18} />+971 55 479 8978</a>
          <a class="line" href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
        </div>
        {offices.map((o) => (
          <div class="off">
            <p class="eyebrow">{o.label}</p>
            <h2>{o.region}</h2>
            <p class="muted"><Icon name="pin" size={16} />{o.company && <>{o.company}, </>}{o.address.join(', ')}</p>
            <p><a href={`mailto:${o.email}`}>{o.email}</a> · <a href={`https://${o.web}`} target="_blank" rel="noopener">{o.web}</a> · <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.address.join(', '))}`} target="_blank" rel="noopener">Map</a></p>
          </div>
        ))}
      </aside>
    </div>
  </section>

</Base>

<style>
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: start; }
  .form { display: grid; gap: 20px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label { display: grid; gap: 8px; font-size: 0.88rem; color: var(--muted); }
  input, select, textarea { background: var(--bg); border: 1px solid var(--line-2); border-radius: 12px; padding: 14px 16px; color: var(--text); font-size: 1rem; transition: border-color 0.2s, box-shadow 0.2s; width: 100%; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%; background-size: 6px 6px; background-repeat: no-repeat; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(79, 195, 255, 0.18); }
  input:user-invalid, textarea:user-invalid { border-color: var(--threat); }
  .chk { display: flex; gap: 12px; align-items: flex-start; line-height: 1.5; }
  .chk input { width: 18px; height: 18px; flex: none; margin-top: 2px; accent-color: var(--accent); }
  .chk a { color: var(--accent); }
  .hp { position: absolute; left: -9999px; }
  .form .btn { justify-self: start; }
  .status { min-height: 1.4em; font-size: 0.95rem; }
  .status.ok { color: #4ade80; } .status.err { color: #ff8a92; }
  .side { display: grid; gap: 28px; }
  .urgent { display: grid; gap: 14px; background: radial-gradient(ellipse at 0 0, rgba(79, 195, 255, 0.12), transparent 60%), var(--bg-2); }
  .big { font-size: 1.4rem; letter-spacing: -0.02em; line-height: 1.3; }
  .urgent .btn { justify-self: start; }
  .line { display: flex; gap: 10px; align-items: center; color: #c9cfdb; }
  .line :global(svg), .off :global(svg) { color: var(--accent); flex: none; }
  .line:hover { color: var(--accent); }
  .off { border-top: 1px solid var(--line); padding-top: 22px; display: grid; gap: 8px; }
  .off h2 { font-size: 1.25rem; letter-spacing: -0.02em; }
  .off .muted { display: flex; gap: 8px; font-size: 0.93rem; }
  .off a { color: var(--accent); font-size: 0.93rem; }
  .xmap { display: block; width: 100%; height: 380px; border: 0; filter: invert(0.9) hue-rotate(180deg) saturate(0.6) brightness(0.9); }
  @media (max-width: 900px) { .layout, .row { grid-template-columns: 1fr; } }
</style>

<script>
  const f = document.getElementById('cf') as HTMLFormElement;
  const st = f.querySelector('.status') as HTMLElement;
  const svc = new URLSearchParams(location.search).get('service');
  if (svc) (f.elements.namedItem('service') as HTMLSelectElement).value = svc;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    st.className = 'status';
    if (!f.checkValidity()) { f.reportValidity(); return; }
    const btn = f.querySelector('button') as HTMLButtonElement;
    btn.disabled = true; st.textContent = 'Sending…';
    try {
      const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.error || 'Something went wrong.');
      f.reset(); st.classList.add('ok'); st.textContent = 'Thank you — your message has been sent. We will be in touch shortly.';
    } catch (err) {
      st.classList.add('err'); st.textContent = `${(err as Error).message} Please email info@cybersentinellab.com or WhatsApp us.`;
    } finally {
      btn.disabled = false;
      (window as any).turnstile?.reset();
    }
  });
</script>
