---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { industries } from '../../data/industries';
const crumbs = [{ name: 'Industries', href: '/industries' }];
---
<Base title="Industries We Protect" description="Cybersecurity for government, banking, healthcare, energy and critical infrastructure, aviation and ports, education, manufacturing, retail, enterprise and SMEs in the UAE, GCC and Europe." crumbs={crumbs}>
  <PageHero title="Security for <em>every</em> sector" lead="Each industry faces its own threats, regulations and stakes. We tailor assessments, controls and response to the realities of your sector." crumbs={crumbs} />
  <section class="section tight">
    <div class="wrap">
      <ul role="list" class="grid g2 list">
        {industries.map((i, n) => (
          <li data-reveal>
            <a class="card hover top ind" href={`/industries/${i.slug}`}>
              <div class="hd"><span class="ic"><Icon name={i.icon} size={26} /></span><span class="n">{String(n + 1).padStart(2, '0')}</span></div>
              <h2>{i.title}</h2>
              <p>{i.summary}</p>
              <span class="go">Explore <span class="arr">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .list { list-style: none; }
  .ind { display: flex; flex-direction: column; gap: 14px; height: 100%; }
  .hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .ic { color: var(--accent); }
  .n { color: var(--muted); font-size: 0.85rem; }
  h2 { font-size: 1.6rem; letter-spacing: -0.025em; }
  p { color: var(--muted); flex: 1; }
  .go { color: var(--accent); font-size: 0.9rem; }
</style>
