---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { industries } from '../../data/industries';
const crumbs = [{ name: 'Industries', href: '/industries' }];
---
<Base title="Industries We Protect" description="Cybersecurity for government, banking, healthcare, energy and critical infrastructure, aviation and ports, education, manufacturing, retail, enterprise and SMEs in the UAE, GCC and Europe." crumbs={crumbs}>
  <PageHero title="Sectors we protect" lead="Each sector faces its own threats, regulations and stakes. We shape assessments, controls and response around the realities of yours." crumbs={crumbs} />
  <section class="section">
    <div class="wrap">
      <ul role="list" class="list">
        {industries.map((i) => (
          <li>
            <a href={`/industries/${i.slug}`}>
              <Icon name={i.icon} size={28} />
              <h2>{i.title}</h2>
              <p>{i.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .list { border-top: 2px solid var(--ink); }
  .list a { display: grid; grid-template-columns: 44px 1fr 1.1fr; gap: 24px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .list a :global(svg) { color: var(--green); align-self: center; }
  h2 { font-stretch: 120%; font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
  p { color: var(--ink-2); }
  .list a:hover h2 { color: var(--green-ink); text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  @media (max-width: 800px) { .list a { grid-template-columns: 34px 1fr; gap: 10px 14px; } p { grid-column: 2; } }
</style>
