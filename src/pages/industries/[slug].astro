---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceRows from '../../components/ServiceRows.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { industries, type Industry } from '../../data/industries';

export function getStaticPaths() {
  return industries.map((i) => ({ params: { slug: i.slug }, props: { i } }));
}
const { i } = Astro.props as { i: Industry };
const crumbs = [{ name: 'Industries', href: '/industries' }, { name: i.title, href: `/industries/${i.slug}` }];
const others = industries.filter((x) => x.slug !== i.slug);
---
<Base title={`Solutions for ${i.title}`} description={i.summary} crumbs={crumbs}>
  <PageHero title={i.title} lead={i.summary} crumbs={crumbs}>
    <div class="ctas"><a class="btn btn-primary" href="/contact">Discuss your requirements</a></div>
  </PageHero>
  <section class="section">
    <div class="wrap two">
      <h2 class="h2">The challenges we see</h2>
      <ul role="list" class="ch">
        {i.challenges.map((c) => <li><Icon name="target" size={22} /><span>{c}</span></li>)}
      </ul>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <h2 class="h2 sh">How CSL helps</h2>
      <ServiceRows only={i.services} />
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <h2 class="h3 sh">Other sectors</h2>
      <ul role="list" class="chips">{others.map((o) => <li><a href={`/industries/${o.slug}`}><Icon name={o.icon} size={18} />{o.title}</a></li>)}</ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .ctas { margin-top: 30px; }
  .two { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .ch { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid var(--ink); }
  .ch li { display: flex; gap: 14px; align-items: flex-start; padding: 22px 20px 22px 0; border-bottom: 1px solid var(--line); font-stretch: 110%; font-weight: 600; font-size: 1.15rem; letter-spacing: -0.01em; line-height: 1.3; }
  .ch :global(svg) { color: var(--respond); flex: none; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .ch { grid-template-columns: 1fr; } }
  .sh { margin-bottom: clamp(24px, 4vw, 44px); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chips a { display: inline-flex; align-items: center; gap: 10px; padding: 11px 18px; border: 1.5px solid var(--ink); border-radius: var(--r-sm); font-weight: 600; }
  .chips a:hover { background: var(--ink); color: #fff; }
  .chips :global(svg) { color: var(--green); }
  .chips a:hover :global(svg) { color: #fff; }
</style>
