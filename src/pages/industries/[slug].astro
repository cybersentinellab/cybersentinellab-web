---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceRows from '../../components/ServiceRows.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { industries, type Industry } from '../../data/industries';

export function getStaticPaths() {
  return industries.map((i) => ({ params: { slug: i.slug }, props: { i } }));
}
const { i } = Astro.props as { i: Industry };
const crumbs = [{ name: 'Industries', href: '/industries' }, { name: i.title, href: `/industries/${i.slug}` }];
const others = industries.filter((x) => x.slug !== i.slug).slice(0, 6);
---
<Base title={`Cybersecurity for ${i.title}`} description={i.summary} crumbs={crumbs}>
  <PageHero title={`${i.title.split(' ')[0]} <em>${i.title.split(' ').slice(1).join(' ') || 'security'}</em>`} lead={i.summary} crumbs={crumbs}>
    <div class="ctas"><a class="btn btn-accent" href="/contact">Discuss your requirements</a></div>
  </PageHero>
  <section class="section tight">
    <div class="wrap">
      <SectionHead eyebrow="The challenge" title="What keeps <em>security teams</em> busy." />
      <ul role="list" class="grid g4 ch">
        {i.challenges.map((c) => <li class="card" data-reveal><Icon name="target" /><span>{c}</span></li>)}
      </ul>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <SectionHead eyebrow="How we help" title="Services for <em>your sector.</em>" />
      <ServiceRows only={i.services} />
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <p class="eyebrow">Other industries</p>
      <ul role="list" class="chips">{others.map((o) => <li><a href={`/industries/${o.slug}`}><Icon name={o.icon} size={18} />{o.title}</a></li>)}</ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .ctas { margin-top: 30px; }
  .ch { list-style: none; }
  .ch li { display: flex; flex-direction: column; gap: 22px; font-size: 1.1rem; font-weight: 500; letter-spacing: -0.01em; }
  .ch :global(svg) { color: var(--threat); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .chips a { display: inline-flex; align-items: center; gap: 10px; padding: 12px 20px; border: 1px solid var(--line-2); border-radius: 999px; }
  .chips a:hover { border-color: var(--accent); color: var(--accent); }
  .chips :global(svg) { color: var(--accent); }
</style>
