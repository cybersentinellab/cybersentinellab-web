---
import { Image } from 'astro:assets';
import { type Post, postUrl, kindMeta, fmtDate, type Kind } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
---
<a class="pc" href={postUrl(post)}>
  {d.cover && <div class="cover"><Image src={d.cover} alt={d.coverAlt ?? ''} widths={[400, 720]} sizes="(max-width: 700px) 100vw, 400px" /></div>}
  <p class="meta">{kindMeta[post.collection as Kind].label}, <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>{d.draft && <span class="dr">Draft</span>}</p>
  <h3>{d.title}</h3>
  <p class="ex">{d.excerpt}</p>
  <span class="more">Read the article</span>
</a>
<style>
  .pc { display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 2px solid var(--ink); height: 100%; }
  .cover { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--r-md); margin-bottom: 8px; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .meta { font-size: 0.88rem; color: var(--muted); display: flex; gap: 10px; align-items: center; }
  .dr { padding: 1px 8px; border-radius: var(--r-sm); background: var(--assess); color: var(--ink); font-size: 0.78rem; font-weight: 600; }
  h3 { font-stretch: 112%; font-size: 1.45rem; font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
  .ex { color: var(--ink-2); font-size: 0.98rem; flex: 1; }
  .more { font-weight: 600; color: var(--green-ink); }
  .pc:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
</style>
