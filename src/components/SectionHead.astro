---
// Section heading. <em> markup from v1 is rendered as plain text in v2.
interface Props { eyebrow?: string; title: string; text?: string; split?: boolean; level?: 'h1' | 'h2' }
const { title, text, split, level = 'h2' } = Astro.props;
const plain = title.replace(/<\/?em>/g, '');
const H = level;
---
<div class:list={['shead', { split }]}>
  <H class={level === 'h1' ? 'h1' : 'h2'}>{plain}</H>
  {text && <p class="lead">{text}</p>}
</div>
