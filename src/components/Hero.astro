---
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid-h">
    <div class="copy">
      <h1 id="hero-title" class="display">Your shield in the digital world.</h1>
      <p class="lead">Cyber Sentinel Lab protects governments and enterprises across the UAE, the GCC and Europe. We find your weaknesses before attackers do, keep your defences strong, and respond fast when something happens.</p>
      <div class="ctas">
        <a href="/contact" class="btn btn-primary">Book a consultation</a>
        <a href="/services" class="btn btn-ghost">Explore services</a>
      </div>
      <p class="sos">Under attack? <a href="tel:+971558817003">Call {site.phones[0]}</a>, 24/7.</p>
    </div>
    <div class="stage" aria-hidden="true">
      <div class="cv"><canvas data-hero></canvas></div>
      <ul class="legend" role="list">
        <li><i class="ph ph-assess"></i>Assess</li>
        <li><i class="ph ph-protect"></i>Protect</li>
        <li><i class="ph ph-respond"></i>Respond</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(110px, 12vw, 150px) 0 clamp(40px, 5vw, 72px); background: var(--paper); overflow: hidden; }
  .grid-h { display: grid; grid-template-columns: 1.08fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: center; }
  .display { font-size: clamp(3rem, 7.2vw, 7.4rem); line-height: 0.9; letter-spacing: -0.045em; }
  .lead { margin-top: clamp(22px, 3vw, 34px); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .sos { margin-top: 26px; font-size: 0.95rem; color: var(--muted); }
  .sos a { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--respond); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .stage { width: 100%; }
  .cv { position: relative; aspect-ratio: 1 / 1; max-height: 620px; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .legend { display: flex; justify-content: flex-end; gap: 16px; margin-top: 8px; font-size: 0.85rem; color: var(--muted); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  @media (max-width: 900px) {
    .grid-h { grid-template-columns: 1fr; }
    .cv { aspect-ratio: 1 / 1; max-height: 380px; }
    .legend { justify-content: center; }
  }
  @media (max-width: 600px) { .ctas .btn { flex: 1 1 100%; } }
</style>

<script>
  import { run } from './hero/core';
  const canvas = document.querySelector('[data-hero]') as HTMLCanvasElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = async () => { const { scene } = await import('./hero/perimeter'); run(canvas, scene, reduced); };
  ('requestIdleCallback' in window ? requestIdleCallback : (f: () => void) => setTimeout(f, 100))(() => void start());
</script>
