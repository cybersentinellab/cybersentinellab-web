---
interface Crumb { name: string; href: string }
interface Props { title: string; lead?: string; crumbs: Crumb[]; eyebrow?: string }
const { title, lead, crumbs, eyebrow } = Astro.props;
const html = title.replace(/<em>(.*?)<\/em>/g, '<span class="s">$1</span>');
---
<header class="phero">
  <div class="wrap g">
    <div>
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/">Home</a>
        {crumbs.map((c, i) => <><span aria-hidden="true">/</span>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</>)}
      </nav>
      {eyebrow && <p class="eyebrow e">{eyebrow}</p>}
      <h1 class="h1 t" set:html={html} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    <slot name="aside" />
  </div>
</header>
<style>
  .g { display: grid; grid-template-columns: 1.4fr 1fr; gap: 60px; align-items: center; }
  .g:not(:has(> :nth-child(2))) { grid-template-columns: 1fr; }
  .e { margin-top: 26px; }
  .t { margin: 22px 0; font-size: clamp(2.6rem, 6vw, 5.25rem); max-width: 18ch; }
  @media (max-width: 900px) { .g { grid-template-columns: 1fr; } }
</style>
