---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<header class="hdr" data-hdr>
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Cyber Sentinel Lab, home">
      <img src="/images/logo-color.svg" alt="Cyber Sentinel Lab" width="200" height="34" />
    </a>
    <nav aria-label="Main">
      <ul role="list" id="menu" class="links">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="m-extra">
          <a href="/contact" class="btn btn-primary">Discuss your requirement</a>
          <a href="tel:+971558817003" class="tel">Incident? Call {site.phones[0]}</a>
        </li>
      </ul>
    </nav>
    <a href="/contact" class="btn btn-primary cta">Discuss your requirement</a>
    <button class="burger" aria-controls="menu" aria-expanded="false" aria-label="Open menu">
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; background: rgba(255, 255, 255, 0.92); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .hdr.open { background: var(--surface); backdrop-filter: none; -webkit-backdrop-filter: none; }
  .bar { display: flex; align-items: center; gap: 32px; height: 76px; }
  .logo img { height: 34px; width: auto; }
  nav { margin-left: auto; }
  .links { display: flex; gap: 26px; font-size: 0.98rem; font-weight: 500; color: var(--ink-2); list-style: none; }
  .links a:not(.btn):hover { color: var(--ink); }
  .links a[aria-current] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; text-decoration-color: var(--green); }
  .cta { padding: 11px 18px; }
  .m-extra, .burger { display: none; }
  .burger { background: none; border: 1.5px solid var(--ink); border-radius: var(--r-sm); width: 44px; height: 44px; place-items: center; cursor: pointer; color: var(--ink); }
  .burger :global(.i-close) { display: none; }
  @media (max-width: 1140px) {
    .bar { height: 66px; }
    .logo img { height: 28px; }
    .cta { display: none; }
    .burger { display: grid; margin-left: auto; }
    nav { position: fixed; inset: 66px 0 0; background: var(--surface); padding: 12px var(--gutter) 28px; transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity 0.2s, transform 0.2s; overflow-y: auto; }
    .open nav { transform: none; opacity: 1; visibility: visible; }
    .links { flex-direction: column; gap: 0; font-stretch: 125%; font-weight: 700; font-size: 1.7rem; letter-spacing: -0.03em; color: var(--ink); }
    .links li { border-bottom: 1px solid var(--line); }
    .links a:not(.btn) { display: block; padding: 18px 0; }
    .links a[aria-current] { text-decoration: none; color: var(--green-ink); }
    .m-extra { display: grid; gap: 18px; border: 0 !important; padding-top: 28px; font-stretch: 100%; font-weight: 500; font-size: 1rem; letter-spacing: 0; }
    .m-extra .btn { width: 100%; }
    .tel { color: var(--ink-2); text-align: center; }
    .open :global(.i-open) { display: none; }
    .open :global(.i-close) { display: block; }
  }
</style>

<script>
  const h = document.querySelector('[data-hdr]') as HTMLElement;
  const b = h.querySelector('.burger') as HTMLButtonElement;
  b.addEventListener('click', () => {
    const open = h.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
    b.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && h.classList.contains('open')) b.click(); });
</script>
