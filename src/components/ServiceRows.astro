---
import { getCollection } from 'astro:content';
interface Props { limit?: number; only?: string[] }
const { limit, only } = Astro.props;
let services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
if (only) services = only.map((s) => services.find((x) => x.id === s)!).filter(Boolean);
if (limit) services = services.slice(0, limit);
---
<ul role="list" class="rows">
  {services.map((s) => (
    <li>
      <a class="row" href={`/services/${s.id}`}>
        <i class={`ph ph-${s.data.phase}`} aria-hidden="true"></i>
        <h3>{s.data.title}</h3>
        <p>{s.data.summary}</p>
      </a>
    </li>
  ))}
</ul>
<style>
  .rows { list-style: none; border-top: 2px solid var(--ink); }
  .row { display: grid; grid-template-columns: 22px 1fr 1.15fr; gap: 24px; align-items: baseline; padding: 26px 0; border-bottom: 1px solid var(--line); }
  h3 { font-stretch: 115%; font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
  p { color: var(--ink-2); }
  .row:hover h3 { color: var(--green-ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 800px) { .row { grid-template-columns: 22px 1fr; gap: 8px 14px; } p { grid-column: 2; } }
</style>
